{
  "name": "@ch-alpineroute/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "pipeline": "node --max-old-space-size=8192 --import tsx src/pipeline/cli.ts",
    "worker": "tsx src/workers/cli.ts",
    "report:quality": "tsx src/scripts/quality-report.ts",
    "calibrate:drive": "node --max-old-space-size=8192 --import tsx src/scripts/calibrate-drive.ts"
  },
  "dependencies": {
    "@ch-alpineroute/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "jose": "^5.9.6",
    "jsfive": "^0.4.2",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "pngjs": "^7.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/geojson": "^7946.0.15",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pngjs": "^6.0.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "exports": {
    "./server": "./src/server/index.ts",
    "./routing": "./src/routing/roadGraph.ts"
  }
}
