# ============================================================================
# Peakr – Umgebungsvariablen
# Kopieren nach ".env" und ausfüllen. Die echte .env wird nie committet.
# Es gibt genau EINE .env im Repository-Root; Web-App, Pipeline und Worker lesen sie.
# ============================================================================

# --- Datenbank (PostgreSQL 16 + PostGIS) -----------------------------------
# Lokal (docker compose up -d db):
POSTGRES_USER=alpine
POSTGRES_PASSWORD=alpine
POSTGRES_DB=peakr
POSTGRES_PORT=5432
DATABASE_URL=postgresql://alpine:alpine@localhost:5432/peakr
# Produktion (Neon, Gratis-Stufe, über die Vercel-Integration angelegt):
#   DATABASE_URL           gepoolte Verbindung (Host mit «-pooler») – nutzt die Website auf Vercel
#   DATABASE_URL_UNPOOLED  direkte Verbindung – nutzen Migration, Pipeline und Worker, falls gesetzt
# TLS wird für alle nicht-lokalen Hosts automatisch verlangt; Parameter wie sslmode oder
# channel_binding in der URL werden vor dem Verbinden entfernt.
# DATABASE_URL_UNPOOLED=

# --- Anmeldung --------------------------------------------------------------
# Signatur-Geheimnis für Anmelde-Token, mindestens 32 Zeichen. In Produktion Pflicht.
#   openssl rand -base64 48
JWT_SECRET=bitte-aendern-mindestens-32-zeichen-langes-geheimnis
JWT_EXPIRES_IN=7d

# --- Optional ---------------------------------------------------------------
# Speicherort der Datenpipeline (Downloads, Zwischenstände, Strassengraph). Standard: ./.data
# DATA_DIR=
# Pfade der Daten-Artefakte, falls nicht unter $DATA_DIR/artifacts/
# ROAD_GRAPH_PATH=
# SEARCH_INDEX_PATH=
# Quelle der Daten-Artefakte für den Vercel-Build (Standard: GitHub-Release «data-latest»)
# PEAKR_DATA_URL=
# Log-Ausgabe: debug | info | warn | error
# LOG_LEVEL=info

# OpenRouteService – NUR für den Qualitätsvergleich der Fahrzeiten (pnpm calibrate:drive).
# Im Betrieb nicht nötig. Kostenloser Schlüssel: https://openrouteservice.org
ORS_API_KEY=

# OpenAI-Anreicherung des Trend-Werts – kostenpflichtig, standardmässig aus.
ENABLE_OPENAI_TREND=false
OPENAI_API_KEY=

# --- Browser (NEXT_PUBLIC_* landen im JavaScript-Bundle: keine Geheimnisse!) --
NEXT_PUBLIC_SWISSTOPO_STYLE_URL=https://vectortiles.geo.admin.ch/styles/ch.swisstopo.lightbasemap.vt/style.json
